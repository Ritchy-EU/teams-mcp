# Azure App Registration
AZURE_CLIENT_ID=your-client-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_SECRET=your-client-secret

# Server
BASE_URL=https://your-domain.com
PORT=8001

# Directory for state that must survive a restart (the OAuth client registry).
# Must be a mounted volume in Docker — otherwise every restart forces all users
# to sign in again. Defaults to ~/.teams-mcp when unset.
TEAMS_MCP_DATA_DIR=/data
